diff --git upstream/lakefile.toml package/lakefile.toml
index 9ebc030..c990ac4 100644
--- upstream/lakefile.toml
+++ package/lakefile.toml
@@ -1,28 +1,24 @@
-name = "NavierStokesAndEuler"
-version = "0.1.0"
-defaultTargets = ["NavierStokes", "Euler", "ComparatorChallenges"]
+name = "NavierStokesCD"
+version = "1.0.0"
+defaultTargets = ["ClayStatement", "NavierStokes", "CDVerified"]
 
 [[require]]
 name = "mathlib"
 scope = "leanprover-community"
 git = "https://github.com/leanprover-community/mathlib4.git"
-rev = "v4.34.0-rc2"
-
-[[require]]
-name = "Comparator"
-scope = "leanprover"
-git = "https://github.com/leanprover/comparator.git"
-rev = "v4.34.0-rc2"
+rev = "d13f23b723b8a846827a245b89c10fc7d3f11612"
 
+# Only the 620 modules in the import closure of the twelve verified results are shipped (see docs/SOURCE_CHANGES.md).
+# The upstream project's Comparator challenge files (which hold `sorry` by design), its Euler library and its
+# unused NavierStokes modules are NOT part of this package, so the build has no unproved declaration.
 [[lean_lib]]
-name = "NavierStokes"
-globs = ["NavierStokes", "NavierStokes.+"]
+name = "ClayStatement"
+globs = ["ClayStatement", "ClayStatement.+"]
 
 [[lean_lib]]
-name = "Euler"
-leanOptions = { autoImplicit = false, warningAsError = true }
-globs = ["Euler", "Euler.+"]
+name = "NavierStokes"
+globs = ["NavierStokes.+"]
 
 [[lean_lib]]
-name = "ComparatorChallenges"
-globs = ["ComparatorChallenges.+"]
+name = "CDVerified"
+globs = ["CDVerification", "CDNonVacuity"]
